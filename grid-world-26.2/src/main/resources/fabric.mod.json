  "authors": ["Shenmi"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "shenmi.gridworld.ShenmiGridWorld"
    ]
  },
  "mixins": [
    "shenmi_grid_world.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
